# Copy to .env and adjust. docker compose reads these; `npm run dev` reads .env.local.

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
# For running the app outside Docker:
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint

# --- Security ---
# Long random string used to sign session cookies. Required in production.
SESSION_SECRET=change-me-in-production-please
# Set true when served over HTTPS.
COOKIE_SECURE=false

# --- Walkthrough scenario ---
# Password for every seeded account (dispatcher, loader, driver, store, vehNNN, outNNN).
DEMO_PASSWORD=waypoint2026
# The seeded delivery day the walkthrough plans.
DEMO_RUN_DATE=2026-04-07
# Scenario clock start (Asia/Colombo). The clock then runs in real time from seeding. Use "off" for the real clock.
DEMO_START=2026-04-06T14:30:00+05:30
# Let the dispatcher restore the seeded day from the UI.
ALLOW_RESET=true
# Show one-click walkthrough accounts and the password on the sign-in page (local demos only).
SHOW_DEMO_ACCOUNTS=false
# Folder with the shared CSVs (outlets, vehicles, calendar, district_travel, service_allowance[, deliveries_train]).
# DATA_DIR=./data

# --- Ports ---
APP_PORT=3000
