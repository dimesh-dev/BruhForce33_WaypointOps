{
  "name": "waypoint",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-setup.ts --reset",
    "plan:preview": "node --env-file-if-exists=.env.local scripts/plan-preview.ts",
    "test": "playwright test tests/engine.spec.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "format": "prettier --write src tests scripts *.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^0.577.0",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
